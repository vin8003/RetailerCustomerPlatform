# Database — loaded by ordering_platform/settings.py
#
# On deploy/dev, omitted keys keep the previous hardcoded fallbacks
# (host 10.0.0.105). Uncomment a key only when you intend to override it.
# os.getenv does not fall back when a key is present but blank —
# an uncommented empty DB_PASSWORD is an empty password, not the fallback.
#
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=buyez_db
# DB_USER=buyez_user
# DB_PASSWORD=
# DB_HOST=10.0.0.105
# DB_PORT=5432
# DB_CONN_MAX_AGE=600
