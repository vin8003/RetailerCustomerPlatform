# Database — loaded by ordering_platform/settings.py
#
# Leave these commented to keep the in-code fallbacks (current deploy).
# Uncomment and set a key only when you intend to override that value.
# Copying uncommented placeholders (empty password, localhost) will
# change which database the app uses — os.getenv does not fall back
# when a key is present but blank.
#
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=buyez_db
# DB_USER=buyez_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=600
