# Database — loaded by ordering_platform/settings.py
#
# Leave these commented to keep the in-code fallbacks in
# ordering_platform/database.py (main currently uses localhost).
# Uncomment and set a key only when you intend to override that value.
# os.getenv does not fall back when a key is present but blank —
# an uncommented empty DB_PASSWORD is an empty password, not the fallback.
#
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=buyez_db
# DB_USER=buyez_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=600

# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=buyez_db
# DB_USER=buyez_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=600
